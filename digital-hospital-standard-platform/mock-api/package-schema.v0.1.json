{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/digital-hospital-package.v0.1.json",
  "title": "数智医院新标准平台数据包",
  "type": "object",
  "required": ["meta"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["packageType", "generatedAt", "taskId", "standardVersion", "hospitalCode"],
      "properties": {
        "packageType": {
          "type": "string",
          "enum": ["submission", "review", "expert", "rectification", "task", "pilot", "collaboration", "assessment", "assistant", "monitoring", "evidence", "analytics", "intelligence", "operations", "system", "full"]
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "taskId": {
          "type": "string"
        },
        "taskName": {
          "type": "string"
        },
        "standardVersion": {
          "type": "string"
        },
        "hospitalCode": {
          "type": "string"
        },
        "hospitalName": {
          "type": "string"
        },
        "prototypeVersion": {
          "type": "string"
        }
      }
    },
    "hospitalProfile": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["indicatorCode", "selfScore", "evidenceCount", "status"],
        "properties": {
          "indicatorCode": {
            "type": "string"
          },
          "indicatorName": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "maxScore": {
            "type": "number"
          },
          "selfScore": {
            "type": "number"
          },
          "reviewedScore": {
            "type": ["number", "null"]
          },
          "evidenceCount": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    },
    "validationIssues": {
      "type": "array"
    },
    "reviewNotes": {
      "type": "array"
    },
    "expertReviewStatus": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "supplement": {
          "type": "integer",
          "minimum": 0
        },
        "adjusted": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "expertReviews": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relatedReviewNotes": {
      "type": "array"
    },
    "relatedIndicators": {
      "type": "array"
    },
    "openIssues": {
      "type": "array"
    },
    "rectifications": {
      "type": "array"
    },
    "scoreResult": {
      "type": "object"
    },
    "operationSummary": {
      "type": "object",
      "properties": {
        "currentStage": {
          "type": "string"
        },
        "completedStages": {
          "type": "integer",
          "minimum": 0
        },
        "totalStages": {
          "type": "integer",
          "minimum": 0
        },
        "openRules": {
          "type": "integer",
          "minimum": 0
        },
        "pendingSecurity": {
          "type": "integer",
          "minimum": 0
        },
        "archiveStatus": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "operations": {
      "type": "object",
      "properties": {
        "cycle": {
          "type": "object"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "standardVersions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ruleSets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "securityItems": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "operationLogs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "openIssueSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "hospitalScope": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "taskSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidenceSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "evidenceMaterials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "hospitalCode", "indicatorCode", "name", "status"],
        "properties": {
          "id": {
            "type": "string"
          },
          "hospitalCode": {
            "type": "string"
          },
          "indicatorCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "version": {
            "type": ["integer", "string"]
          },
          "sensitivity": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string"
          },
          "watermark": {
            "type": ["boolean", "string"]
          }
        },
        "additionalProperties": true
      }
    },
    "missingIndicators": {
      "type": "array",
      "items": {
        "type": ["object", "string"]
      }
    },
    "reviewAssignments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scoringRules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "bottomLineRules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "analyticsSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "appeals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "intelligenceSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "spotChecks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sandboxConfig": {
      "type": "object",
      "additionalProperties": true
    },
    "sandboxRuns": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "materialClassifications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "peerAnomalies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "notificationChannels": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "importJobs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "submissionBatches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uploadQueue": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewerWorkloads": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dailyReports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "collaborationSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "hospitalReadiness": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotTickets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "trainingSessions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotReleases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotFeedback": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assessmentSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "pilotOutcomeMetrics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotHospitalOutcomes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotIssueThemes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotImprovementPlans": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rolloutRegions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pilotAssessmentReports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assistantSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "assistantKnowledgeSources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assistantKnowledgeVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceId", "version", "checksum", "status"],
        "properties": {
          "id": { "type": "string" },
          "sourceId": { "type": "string" },
          "version": { "type": "string" },
          "checksum": { "type": "string" },
          "status": { "type": "string", "enum": ["草稿", "待审批", "已批准", "已发布"] }
        }
      }
    },
    "standardQaRecords": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "assistantRetrievalTraces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "questionId", "topMatches", "threshold", "status"],
        "properties": {
          "id": { "type": "string" },
          "questionId": { "type": "string" },
          "topMatches": { "type": "array", "items": { "type": "object" } },
          "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": { "type": "string", "enum": ["命中充分", "需补充", "人工复核"] }
        }
      }
    },
    "assistantModelCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "businessId", "promptVersion", "requestDigest", "responseDigest", "callStatus", "reviewStatus"],
        "properties": {
          "id": { "type": "string" },
          "businessId": { "type": "string" },
          "promptVersion": { "type": "string" },
          "requestDigest": { "type": "string" },
          "responseDigest": { "type": "string" },
          "callStatus": { "type": "string", "enum": ["成功", "降级", "失败"] },
          "reviewStatus": { "type": "string", "enum": ["待复核", "已复核"] }
        }
      }
    },
    "assistantQualityGate": {
      "type": "object",
      "required": ["citationCoverage", "answerAccuracy", "retrievalRecall", "safetyCompliance", "maxLatencyMs", "maxRegressionPoints"],
      "properties": {
        "citationCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
        "answerAccuracy": { "type": "number", "minimum": 0, "maximum": 100 },
        "retrievalRecall": { "type": "number", "minimum": 0, "maximum": 100 },
        "safetyCompliance": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxLatencyMs": { "type": "integer", "minimum": 0 },
        "maxRegressionPoints": { "type": "number", "minimum": 0 }
      }
    },
    "assistantEvaluationSuites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "caseCount", "status"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "caseCount": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "enum": ["草稿", "待复核", "已发布", "已停用"] }
        }
      }
    },
    "assistantEvaluationRuns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "candidateVersion", "score", "gateStatus", "status"],
        "properties": {
          "id": { "type": "string" },
          "candidateVersion": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "gateStatus": { "type": "string", "enum": ["通过", "阻断"] },
          "status": { "type": "string", "enum": ["排队中", "运行中", "已完成", "失败"] }
        }
      }
    },
    "assistantReleaseCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "evaluationRunId", "gateStatus", "status"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "evaluationRunId": { "type": "string" },
          "gateStatus": { "type": "string", "enum": ["通过", "阻断"] },
          "status": { "type": "string", "enum": ["候选", "待审批", "已发布", "历史版本", "已回滚"] }
        }
      }
    },
    "assistantOnlineGuardrail": {
      "type": "object",
      "required": ["citationCoverage", "answerAcceptance", "maxNoAnswerRate", "maxEscalationRate", "maxP95LatencyMs", "maxSafetyEvents", "maxDriftScore"],
      "properties": {
        "citationCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
        "answerAcceptance": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxNoAnswerRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxEscalationRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxP95LatencyMs": { "type": "integer", "minimum": 0 },
        "maxSafetyEvents": { "type": "integer", "minimum": 0 },
        "maxDriftScore": { "type": "number", "minimum": 0 }
      }
    },
    "assistantDeployments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "releaseId", "version", "strategy", "trafficPercent", "cohorts", "stableVersion", "status"],
        "properties": {
          "id": { "type": "string" },
          "releaseId": { "type": "string" },
          "version": { "type": "string" },
          "strategy": { "type": "string", "enum": ["灰度", "全量"] },
          "trafficPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "cohorts": { "type": "array", "items": { "type": "string" } },
          "stableVersion": { "type": "string" },
          "status": { "type": "string", "enum": ["稳定", "灰度中", "已暂停", "已完成", "历史版本", "已回滚"] }
        }
      }
    },
    "assistantOnlineQualityWindows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "deploymentId", "version", "sampleCount", "citationCoverage", "answerAcceptance", "noAnswerRate", "escalationRate", "p95LatencyMs", "safetyEvents", "driftScore", "status"],
        "properties": {
          "id": { "type": "string" },
          "deploymentId": { "type": "string" },
          "version": { "type": "string" },
          "sampleCount": { "type": "integer", "minimum": 0 },
          "citationCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
          "answerAcceptance": { "type": "number", "minimum": 0, "maximum": 100 },
          "noAnswerRate": { "type": "number", "minimum": 0, "maximum": 100 },
          "escalationRate": { "type": "number", "minimum": 0, "maximum": 100 },
          "p95LatencyMs": { "type": "integer", "minimum": 0 },
          "safetyEvents": { "type": "integer", "minimum": 0 },
          "driftScore": { "type": "number", "minimum": 0 },
          "status": { "type": "string", "enum": ["健康", "关注", "异常"] }
        }
      }
    },
    "assistantQualityIncidents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "deploymentId", "version", "signal", "level", "threshold", "actual", "action", "owner", "status", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "deploymentId": { "type": "string" },
          "version": { "type": "string" },
          "signal": { "type": "string" },
          "level": { "type": "string", "enum": ["中", "高", "紧急"] },
          "threshold": { "type": "string" },
          "actual": { "type": "string" },
          "action": { "type": "string" },
          "owner": { "type": "string" },
          "status": { "type": "string", "enum": ["开放", "处理中", "已解决"] },
          "createdAt": { "type": "string" },
          "resolvedAt": { "type": "string" }
        }
      }
    },
    "anomalyExplanations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rectificationSuggestions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewRiskSignals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "monitoringSummary": {
      "type": "object",
      "additionalProperties": true
    },
    "serviceHealth": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "interfaceHealth": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "jobQueues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "storagePools": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "monitoringAlerts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "exportApprovals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "systemParams": {
      "type": ["array", "object"]
    },
    "auditLogs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
