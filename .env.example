# chronic-care-platform environment template

# HTTP port used by server.js. Defaults to 5173.
PORT=5173

# Runtime environment label shown by /api/health and /api/metrics.
NODE_ENV=production

# Storage engine: auto, sqlite, or json.
# auto uses node:sqlite when the runtime supports it and keeps data/db.json as a static snapshot.
STORAGE_ENGINE=auto

# Required production SQLite durability profile. The runtime applies these settings to every connection.
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=FULL
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
SQLITE_HEALTH_CHECK_TTL_MS=30000

# Required when STORAGE_ENGINE=postgres or postgresql.
# DATABASE_URL=postgres://health:replace-with-password@postgres.internal:5432/chronic_care

# Optional external data directory. Defaults to ./data.
# DATA_DIR=/var/lib/chronic-care-platform

# Comma-separated session signing secrets. Put the newest first during rotation.
SESSION_SECRETS=replace-with-long-random-secret

# HMAC signing secret for integration gateway simulation.
INTEGRATION_GATEWAY_SECRET=replace-with-integration-secret

# Production government identity and resident SMS adapters. Required by env:check:production.
# OIDC_ISSUER_URL=https://identity.example.gov.cn/real-issuer
# OIDC_USERINFO_URL=https://identity.example.gov.cn/real-issuer/userinfo
# OIDC_CLIENT_ID=replace-with-oidc-client-id
# OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
# IDENTITY_ADAPTER_TIMEOUT_MS=8000
# CA_GATEWAY_URL=https://ca.example.gov.cn/real-gateway
# SMS_GATEWAY_URL=https://sms.example.gov.cn/real-gateway
# SMS_GATEWAY_TOKEN=replace-with-provider-token
# SMS_TEMPLATE_ID=resident-login-code
# SMS_SENDER=health-platform
# SMS_GATEWAY_TIMEOUT_MS=8000

# Hospital core-system outbound adapters. A shared signing secret can be replaced by per-domain secrets.
# HOSPITAL_ADAPTER_SECRET=replace-with-hospital-connector-signing-secret
# HOSPITAL_ADAPTER_TOKEN=replace-with-optional-shared-bearer-token
# HIS_ADAPTER_URL=https://his.example.gov.cn/platform/events
# EMR_ADAPTER_URL=https://emr.example.gov.cn/platform/events
# LIS_ADAPTER_URL=https://lis.example.gov.cn/platform/events
# PACS_ADAPTER_URL=https://pacs.example.gov.cn/platform/events
# APPOINTMENT_ADAPTER_URL=https://his.example.gov.cn/platform/appointments
# HIS_ADAPTER_SECRET=replace-with-optional-his-specific-secret
# EMR_ADAPTER_SECRET=replace-with-optional-emr-specific-secret
# LIS_ADAPTER_SECRET=replace-with-optional-lis-specific-secret
# PACS_ADAPTER_SECRET=replace-with-optional-pacs-specific-secret
# APPOINTMENT_ADAPTER_SECRET=replace-with-optional-appointment-specific-secret
# HOSPITAL_ADAPTER_TIMEOUT_MS=8000
# HOSPITAL_ADAPTER_MAX_ATTEMPTS=3

# Secure attachment object-storage gateway.
# OBJECT_STORAGE_GATEWAY_URL=https://storage.example.gov.cn/api/
# OBJECT_STORAGE_BUCKET=health-platform-attachments
# OBJECT_STORAGE_SIGNING_SECRET=replace-with-object-storage-signing-secret
# OBJECT_STORAGE_TOKEN=replace-with-optional-object-storage-token
# OBJECT_STORAGE_TIMEOUT_MS=8000
# OBJECT_STORAGE_MAX_BYTES=104857600
# OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=300

# Payment, medical-insurance and electronic-certificate production gateways.
# FINANCIAL_GATEWAY_SECRET=replace-with-shared-financial-signing-secret
# FINANCIAL_GATEWAY_TOKEN=replace-with-optional-shared-bearer-token
# PAYMENT_GATEWAY_URL=https://payment.example.gov.cn/platform/transactions
# INSURANCE_GATEWAY_URL=https://insurance.example.gov.cn/platform/settlements
# CERTIFICATE_GATEWAY_URL=https://certificate.example.gov.cn/platform/certificates
# PAYMENT_GATEWAY_SECRET=replace-with-optional-payment-specific-secret
# INSURANCE_GATEWAY_SECRET=replace-with-optional-insurance-specific-secret
# CERTIFICATE_GATEWAY_SECRET=replace-with-optional-certificate-specific-secret
# PAYMENT_GATEWAY_TOKEN=replace-with-optional-payment-token
# INSURANCE_GATEWAY_TOKEN=replace-with-optional-insurance-token
# CERTIFICATE_GATEWAY_TOKEN=replace-with-optional-certificate-token
# FINANCIAL_GATEWAY_TIMEOUT_MS=8000
# FINANCIAL_GATEWAY_MAX_ATTEMPTS=3

# Production audit retention target. At least one of AUDIT_EXPORT_PATH or SIEM_ENDPOINT is required.
# AUDIT_EXPORT_PATH=/var/log/chronic-care-platform/audit
# SIEM_ENDPOINT=https://siem.example.gov.cn/ingest
# SIEM_SIGNING_SECRET=replace-with-siem-alert-signing-secret
# SIEM_TOKEN=replace-with-optional-siem-token
# ALERT_WEBHOOK_URL=https://alerts.example.gov.cn/platform/events
# ALERT_WEBHOOK_SECRET=replace-with-alert-webhook-signing-secret
# ALERT_WEBHOOK_TOKEN=replace-with-optional-alert-webhook-token
# ALERTING_TIMEOUT_MS=8000
# ALERTING_MAX_ATTEMPTS=3
# RETENTION_POLICY=10y-worm

# Production cutover site signoff flags. Use signed/approved/true only after the real evidence is archived.
# CUTOVER_SITE_INTERFACE_SIGNOFF=signed
# CUTOVER_CHRONIC_LAUNCH_CORE_SIGNOFF=signed
# CUTOVER_INSURANCE_CERTIFICATE_SIGNOFF=signed
# CUTOVER_MONITORING_SIGNOFF=signed
# CUTOVER_DR_REHEARSAL_SIGNOFF=signed
