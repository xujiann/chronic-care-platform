{
  "schemaVersion": "platform-iteration-program-v1",
  "programId": "preproduction-six-iteration-control-20260804",
  "integrationBranch": "main",
  "baselineTag": "baseline/governance-20260805-public-health-direct-report-outbox-v1",
  "policy": {
    "integrationOwner": "T00",
    "orderedExecution": true,
    "defaultDecision": "NO-GO",
    "externalEvidenceCannotBeInferred": true,
    "secretsAndPatientDataForbidden": true,
    "productionCutoverRequiresIndependentApproval": true
  },
  "iterations": [
    {
      "id": "iteration-1",
      "name": "可信身份与远程签名",
      "deliverables": [
        "远程信任提供方快照",
        "固定根签名与身份职责范围绑定",
        "密钥轮换冻结吊销退役过期",
        "失败关闭健康检查"
      ],
      "requiredLocalGates": ["provider-attestation", "identity-scope-binding", "key-lifecycle", "fail-closed-health"],
      "requiredExternalGates": ["real-kms-hsm-provider-snapshot"]
    },
    {
      "id": "iteration-2",
      "name": "预生产环境与恢复验收",
      "deliverables": [
        "五类基础组件独立复核",
        "四类故障恢复场景",
        "RPO与RTO目标校验",
        "发布包和环境绑定"
      ],
      "requiredLocalGates": ["preproduction-components", "recovery-scenarios", "rpo-rto", "release-binding"],
      "requiredExternalGates": ["controlled-preproduction-evidence"]
    },
    {
      "id": "iteration-3",
      "name": "外部双签名联调战役",
      "deliverables": [
        "十二类外部系统契约",
        "八类正常与异常场景",
        "九十六项双签回执",
        "发布包绑定与撤销校验"
      ],
      "requiredLocalGates": ["twelve-system-contracts", "ninety-six-scenarios", "dual-signature-verification", "release-binding"],
      "requiredExternalGates": ["signed-joint-test-receipts"]
    },
    {
      "id": "iteration-4",
      "name": "监控告警与安全验收",
      "deliverables": [
        "证据密钥签名账本和演练告警",
        "SIEM与Webhook可靠投递",
        "确认升级恢复与死信重放",
        "哈希链和独立安全复核"
      ],
      "requiredLocalGates": ["alert-candidates", "reliable-delivery", "ack-escalate-recover", "acceptance-validator"],
      "requiredExternalGates": ["signed-monitoring-security-acceptance"]
    },
    {
      "id": "iteration-5",
      "name": "七席位预生产切换演练",
      "deliverables": [
        "七个唯一职责账号",
        "六个切换与回滚检查点",
        "精确回滚口令和时间预算",
        "T+1六类观察面"
      ],
      "requiredLocalGates": ["seven-duty-seats", "six-checkpoints", "rollback-command", "t-plus-one-observation"],
      "requiredExternalGates": ["signed-human-rehearsal-receipt"]
    },
    {
      "id": "iteration-6",
      "name": "统一候选评审与发布阻断",
      "deliverables": [
        "五类控制报告统一绑定",
        "阻断项责任人与后续动作",
        "GO-CANDIDATE与执行权限分离",
        "唯一集成基线"
      ],
      "requiredLocalGates": ["common-release-binding", "candidate-review", "fail-closed-boundary", "single-integration-baseline"],
      "requiredExternalGates": [
        "current-external-evidence",
        "four-party-go-no-go"
      ]
    }
  ]
}
