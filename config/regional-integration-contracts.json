      "operations": ["receive-observation-result", "acknowledge-result"],
      "correlationFields": ["requestId", "correlationId", "specimenId"],
      "jointTestStatus": "pending-external"
    },
    {
      "id": "pacs-imaging-v1",
      "system": "PACS",
      "direction": "bidirectional",
      "protocol": "DICOMWEB-HTTPS",
      "endpointEnv": "REGIONAL_PACS_ENDPOINT",
      "credentialRefEnv": "REGIONAL_PACS_CREDENTIAL_REF",
      "operations": ["query-study", "publish-report-reference"],
      "correlationFields": ["requestId", "correlationId", "studyInstanceUidDigest"],
      "jointTestStatus": "pending-external"
    }
  ]
