      "credentialRefEnv": "REGIONAL_HIS_CREDENTIAL_REF",
      "operations": ["submit-referral", "query-acceptance", "cancel-referral"],
      "correlationFields": ["requestId", "correlationId", "referralId"],
      "jointTestStatus": "pending-external"
    },
    {
      "id": "emr-clinical-summary-v1",
      "system": "EMR",
      "direction": "bidirectional",
      "protocol": "FHIR-R4-HTTPS",
      "endpointEnv": "REGIONAL_EMR_ENDPOINT",
      "credentialRefEnv": "REGIONAL_EMR_CREDENTIAL_REF",
      "operations": ["publish-document-reference", "query-clinical-summary"],
      "correlationFields": ["requestId", "correlationId", "documentDigest"],
      "jointTestStatus": "pending-external"
    },
    {
      "id": "lis-result-v1",
      "system": "LIS",
      "direction": "inbound",
      "protocol": "HL7V2-OVER-MTLS",
