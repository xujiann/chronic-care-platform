        "residents",
        "accounts",
        "personalRecords",
        "diseases",
        "chronicScreeningTasks",
        "phase2FamilyDoctorContracts",
        "secureAttachments",
        "securityEvents",
        "taskMessages"
      ],
      "implementedUseCases": [
        {
          "id": "physical-examination-dashboard-query.v1",
          "source": "src/clinical-specialties/physical-examination/dashboard-query.js",
          "route": "GET /api/physical-exams",
          "ports": ["buildPhysicalExamOverview", "buildPhysicalExamReadiness"],
          "contracts": [],
          "sideEffects": ["resident-data-access-audit-persisted-by-http-adapter"]
        },
        {
          "id": "physical-examination-specialized-intake-action-command.v1",
          "source": "src/clinical-specialties/physical-examination/specialized-intake-action-command.js",
          "route": "POST /api/physical-exams/specialized-intakes/:id/actions",
          "ports": [
            "applySpecializedIntakeAction",
            "appendDataAccessLog",
            "appendSecurityEvent",
            "normalizeState",
            "now",
            "writeDatabase"
          ],
          "contracts": [],
          "sideEffects": [
            "physicalExamSpecializedIntakes-state-mutation",
            "resident-data-access-audit",
            "security-event-audit",
            "legacy-database-persistence"
