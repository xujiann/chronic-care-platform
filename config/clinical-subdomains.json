          "id": "imaging-dashboard-query.v1",
          "source": "src/clinical-specialties/imaging/dashboard-query.js",
          "route": "GET /api/imaging-cloud",
          "ports": ["buildImagingDashboard", "redactSensitiveResponse"],
          "contracts": [],
