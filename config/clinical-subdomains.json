  "routeSubcontextAssignments": {
    "imaging-cloud": { "owners": ["imaging"], "status": "aligned" },
    "emergency-care": { "owners": ["emergency"], "status": "aligned" },
    "quality-safety": { "owners": ["quality-safety"], "status": "aligned" },
    "clinical-blood": { "owners": ["blood", "imaging"], "status": "legacy-mixed" },
    "mutual-recognition-ingest": { "owners": ["imaging"], "status": "aligned" },
    "mutual-recognition-review": { "owners": ["imaging"], "status": "aligned" },
    "emergency-signals": { "owners": ["emergency"], "status": "aligned" },
    "blood-innovation": { "owners": ["blood", "physical-examination"], "status": "legacy-mixed" }
  },
  "legacyRouteAreas": [
    {
      "id": "legacy-platform-operations",
      "routePrefixes": ["/api/operations"],
      "currentRouteSubcontexts": [],
      "completedRouteSubcontexts": ["operations-dashboard", "operations-command"],
      "targetDomain": "platform-governance/operations",
      "handoffOwners": ["T00", "T02"],
      "status": "handoff-complete"
    }
  ],
  "crossSubdomainContracts": [
    {
      "id": "blood-emergency-coordination.v1",
      "version": "1.0.0",
      "providers": ["blood"],
      "consumers": ["emergency"],
      "interaction": "versioned-query",
      "requiredFields": ["projectionId", "status", "occurredAt"],
      "currentBinding": "EmergencyDashboardQuery.readBloodCoordination -> BloodEventHub.dashboard",
      "status": "legacy-adapter"
    },
    {
      "id": "blood-quality-signal.v1",
      "version": "1.0.0",
      "providers": ["blood"],
      "consumers": ["quality-safety"],
      "interaction": "versioned-query",
      "requiredFields": ["eventId", "eventType", "status", "occurredAt"],
      "currentBinding": "BloodEventHub.dashboard",
      "status": "legacy-adapter"
    },
    {
      "id": "clinical-quality-observation.v1",
      "version": "1.0.0",
      "providers": ["emergency", "blood", "imaging", "physical-examination"],
      "consumers": ["quality-safety"],
      "interaction": "event-read-model",
      "requiredFields": ["sourceSubdomain", "subjectRef", "eventType", "status", "occurredAt"],
      "status": "target-contract"
    }
  ],
  "sharedPlatformPorts": [
    "identity-and-authorization",
    "resident-mpi",
    "institution-and-practitioner-directory",
    "audit-and-security-events",
    "integration-gateway",
    "object-storage",
    "transactional-outbox",
    "regional-context",
    "observability"
  ],
  "sourceRules": {
    "forbidServerDependency": true,
    "forbidCrossSubdomainImplementationImports": true,
    "crossSubdomainAccess": ["versioned-query", "event-read-model", "owner-command-port"]
  },
  "independentDevelopmentExitCriteria": [
    { "id": "machine-registry", "status": "met" },
    { "id": "api-prefix-ownership", "status": "met" },
    { "id": "data-subdomain-ownership", "status": "partial" },
    { "id": "versioned-cross-subdomain-contracts", "status": "partial" },
    { "id": "source-directory-isolation", "status": "partial" },
    { "id": "independent-domain-tests", "status": "met" },
    { "id": "independent-ci-gates", "status": "met" }
  ]
}
