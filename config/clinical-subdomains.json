    {
      "id": "imaging",
      "name": "影像",
      "owner": "T06/imaging",
      "targetSourceRoot": "src/clinical-specialties/imaging",
      "routePrefixes": ["/api/imaging-cloud", "/api/mutual-recognition"],
      "roleEnvelope": ["commission", "institution", "county", "citizen"],
      "testGate": {
