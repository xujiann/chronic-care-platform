{
  "schemaVersion": "1.0.0",
  "domain": "clinical-specialties",
  "processOwner": "T06",
  "architecture": "modular-monolith",
  "deploymentBoundary": "shared-node-runtime",
  "independentDeploymentAuthorized": false,
  "testGovernance": {
    "schemaVersion": "1.0.0",
    "runner": "scripts/clinical-subdomain-test-gate.js",
    "allEntrypoint": "node scripts/clinical-subdomain-test-gate.js --all",
    "ciScript": "clinical-subdomains:test",
    "sharedGovernanceTests": ["test/clinical-subdomain-governance.test.js"],
    "productionReady": false
  },
  "routeSourceRoot": "src/http/routes/clinical-specialties",
  "routeImplementationSources": [
    {
      "subdomain": "blood",
      "source": "src/clinical-specialties/blood/http-handler.js",
      "mountedBy": [
        "src/http/routes/clinical-specialties/blood-innovation.js",
        "src/http/routes/clinical-specialties/clinical-blood.js"
      ]
    }
  ],
