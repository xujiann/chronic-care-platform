{
  "schemaVersion": "platform-lifecycle-governance-v1",
  "authority": {
    "controlTower": "T00",
    "integrationBranch": "main",
    "developmentBase": "origin/main",
    "taskLedger": "config/lifecycle-governance.json#tasks",
    "productionDecision": "config/lifecycle-governance.json#productionAdmission"
  },
  "capabilityStatusLifecycle": [
    "未建设",
    "已实现",
    "已验证",
    "已集成",
    "准生产",
    "已投产"
  ],
  "taskStatusLifecycle": [
    "候选",
    "待批准",
    "已批准",
    "实施中",
    "验证中",
    "待集成",
    "已关闭",
    "已阻塞"
  ],
  "portfolioPolicy": {
    "wipStatuses": ["已批准", "实施中", "验证中", "待集成"],
    "maximumWip": 5,
    "recommendedWip": { "minimum": 3, "maximum": 5 },
    "oneWriterPerCoreScope": true,
    "highRiskDownstreamExpansionAllowed": false,
    "productionDefault": "NO-GO"
  },
  "riskApprovalPolicy": {
    "低": "approved-task-package",
    "中": "T00-plan-approval",
    "高": "accepted-adr-human-review-special-validation"
  },
  "requirements": [
    {
      "id": "REQ-GOV-001",
      "title": "建立超大型平台全生命周期治理工作流",
      "sourceType": "approved-user-requirement",
      "sourceRef": "USER-APPROVED-2026-09-07",
      "acceptance": [
        "T00仅承担组合控制、风险汇总和放行结论",
        "任务、地图、测试和生产准入使用同一机器追踪链",
        "仓库交付和生产投产状态不可混用"
      ]
    },
    {
      "id": "REQ-OPS-015",
      "title": "影像质控外部回写失败必须可判定和可恢复",
      "sourceType": "approved-user-requirement",
      "sourceRef": "USER-APPROVED-2026-09-07",
      "acceptance": [
        "无有效 FHIR 资源回执不得提交本地质控状态",
        "未知外部结果和外部成功后本地失败必须明确要求对账",
        "失败路径不得把暂存修改泄漏到已加载状态"
      ]
    },
    {
      "id": "REQ-OPS-016",
      "title": "体检专项动作必须具备可恢复并发与重复提交控制",
      "sourceType": "approved-user-requirement",
      "sourceRef": "USER-APPROVED-2026-09-07",
      "acceptance": [
        "显式命令键与 actor、资源和 payload 绑定",
        "业务变更、版本、回执和审计必须原子提交",
        "旧客户端兼容但不得被误报为幂等"
      ]
    },
    {
      "id": "REQ-OPS-017",
      "title": "居民已完成护理和陪诊服务必须可评价并发起投诉跟进",
      "sourceType": "approved-user-requirement",
      "sourceRef": "USER-APPROVED-2026-09-07",
      "acceptance": [
        "仅本人已完成的护理或陪诊服务可提交一次评价",
        "投诉必须生成机构待跟进消息",
        "浏览器提交失败必须保留居民草稿"
      ]
    },
    {
      "id": "REQ-OPS-018",
      "title": "影像质控未知或部分提交结果必须可安全查看和人工核对",
      "sourceType": "approved-user-requirement",
      "sourceRef": "USER-APPROVED-2026-09-07-BATCH-2",
      "acceptance": [
        "未知外部结果不得被显示为已确认或自动重试",
        "外部已确认但本地未提交时只暴露最小白名单回执并保持写操作锁定",
        "状态查看必须严格读取真实本地接口且读取失败不得回退演示事实"
      ]
    },
    {
      "id": "REQ-OPS-019",
      "title": "居民评价投诉前端变更必须使已安装 PWA 客户端获取新资产",
      "sourceType": "integration-dependency",
      "sourceRef": "OPS-017-PR-264-REVIEW-2026-09-08",
      "acceptance": [
        "Service Worker 缓存版本必须在评价投诉资产变更后递增",
        "激活新版本时必须清理旧缓存且仅保留当前缓存",
        "PWA 浏览器测试必须证明当前缓存、旧缓存清理和离线边界"
      ]
    },
    {
      "id": "REQ-SEC-009",
      "title": "投诉跟进站内消息必须按目标角色和目标机构严格授权",
      "sourceType": "security-review-finding",
      "sourceRef": "OPS-017-PR-264-REVIEW-2026-09-08",
      "acceptance": [
        "居民不得读取或回执机构目标消息",
        "机构用户仅可读取和回执绑定其机构且角色匹配的消息",
        "角色、机构、居民和回执状态的越权矩阵必须通过真实 HTTP 负向测试"
      ]
    },
    {
      "id": "REQ-GOV-003",
      "title": "体检专项分流动作整端点行为证据必须进入中央幂等注册表",
      "sourceType": "integrated-evidence-gap",
      "sourceRef": "OPS-016-PR-263-PR-268-2026-09-08",
      "acceptance": [
        "唯一 endpoint 合同覆盖 assign-profile、return-source 和 close 且无未验证余项",
        "合同绑定真实 HTTP、命令、路由、范围、CAS、审计和稳定错误证据",
        "目录只允许 repository behavior-verified，productionReady 与外部证据门禁保持失败关闭"
      ]
    },
    {
      "id": "REQ-TEST-019",
      "title": "夜间生命周期门禁必须安装其声明使用的浏览器运行时",
      "sourceType": "observed-ci-failure",
      "sourceRef": "https://github.com/xujiann/chronic-care-platform/actions/runs/34160212594",
      "acceptance": [
        "定时和手工 nightly 执行前安装 Playwright Chromium 及系统依赖",
        "quick、pr 和 release 调度不承担无关浏览器安装成本",
        "生命周期工作流的官方 Action SHA 纳入机器漂移测试"
      ]
    },
    {
      "id": "REQ-TEST-020",
      "title": "变更影响分析的全量单元回退必须在 Windows 可靠启动",
      "sourceType": "observed-gate-failure",
      "sourceRef": "OPS-016-2026-09-08-TEST-CHANGED-DIAGNOSIS",
      "acceptance": [
        "Windows 优先使用当前 npm 的 Node 入口而不是直接启动批处理文件",
        "未知变更仍执行完整 test:unit 且失败语义不放宽",
        "跨平台调用选择具备可执行单元合同且启动错误以稳定错误码传播"
      ]
    }
  ],
  "regulatoryControls": [
    {
      "id": "REG-GOV-001",
      "title": "生产准入必须基于真实外部证据和责任方签署",
      "sourceType": "repository-production-safety-control",
      "sourceRef": "AGENTS.md#production-safety"
    }
  ],
  "risks": [
    {
      "id": "RISK-GOV-001",
      "level": "高",
      "title": "局部代码完成被误报为平台能力或生产完成",
      "owner": "T00",
      "mitigation": "用状态生命周期、证据门禁和生产准入矩阵失败关闭",
      "status": "mitigated",
      "evidenceIds": ["EVD-GOV-001"]
    },
    {
      "id": "RISK-OPS-015",
      "level": "高",
      "title": "影像质控跨系统双写结果不一致",
      "owner": "T06",
      "mitigation": "验证 FHIR 回执并对未知或部分提交结果失败关闭为人工对账",
      "status": "open",
      "evidenceIds": ["EVD-OPS-015"]
    },
    {
      "id": "RISK-OPS-016",
      "level": "高",
      "title": "体检专项动作重复执行或并发覆盖",
      "owner": "T06",
      "mitigation": "显式幂等回执、乐观版本和锁内范围校验；分布式 exactly-once 仍未关闭",
      "status": "open",
      "evidenceIds": ["EVD-OPS-016", "EVD-OPS-016B"]
    },
    {
      "id": "RISK-OPS-017",
      "level": "中",
      "title": "居民评价越权、重复或投诉丢失",
      "owner": "T04",
      "mitigation": "复用居民范围门禁，限制完成态和一次提交，并为 open 投诉生成机构消息",
      "status": "open",
      "evidenceIds": ["EVD-OPS-017"]
    },
    {
      "id": "RISK-OPS-018",
      "level": "中",
      "title": "影像质控未知结果被误报成功或触发重复外部副作用",
      "owner": "T06",
      "mitigation": "只读核对、最小回执白名单和需对账状态持续锁定；耐久补偿另行高风险决策",
      "status": "mitigated",
      "evidenceIds": ["EVD-OPS-015", "EVD-OPS-015B", "EVD-OPS-018"]
    },
    {
      "id": "RISK-OPS-019",
      "level": "低",
      "title": "已安装 PWA 继续使用评价投诉变更前的旧资产",
      "owner": "T04",
      "mitigation": "递增缓存命名并以浏览器测试证明安装、激活、旧缓存清理和离线边界",
      "status": "open",
      "evidenceIds": []
    },
    {
      "id": "RISK-SEC-009",
      "level": "高",
      "title": "机构目标投诉消息被居民或错误机构读取和回执",
      "owner": "T05",
      "mitigation": "在实施前完成 Accepted ADR、人工评审和专项授权矩阵，再绑定目标角色、目标机构与回执状态",
      "status": "open",
      "evidenceIds": []
    },
    {
      "id": "RISK-GOV-003",
      "level": "中",
      "title": "局部或不完整证据被误登记为整端点行为验证",
      "owner": "T00",
      "mitigation": "严格登记三动作无余项合同并由目录测试拒绝 action-slice 冒充、生产晋级和漂移",
      "status": "open",
      "evidenceIds": []
    },
    {
      "id": "RISK-TEST-019",
      "level": "低",
      "title": "夜间门禁因缺少浏览器运行时产生全量伪失败",
      "owner": "T00",
      "mitigation": "仅在 schedule 或 nightly 输入时显式安装 Chromium 并锁定工作流合同",
      "status": "mitigated",
      "evidenceIds": ["EVD-TEST-019"]
    },
    {
      "id": "RISK-TEST-020",
      "level": "低",
      "title": "Windows 门禁调度错误把已通过的全量测试报告为失败",
      "owner": "T00",
      "mitigation": "通过当前 npm Node 入口启动固定脚本并保留未知变更全量回退",
      "status": "mitigated",
      "evidenceIds": ["EVD-TEST-020", "EVD-TEST-020-CI"]
    }
  ],
