{
  "schemaVersion": "high-risk-api-authorization-v1",
  "routes": {
    "PUT /api/state": { "owner": "T02", "roles": ["commission"], "dataScope": "platform", "purpose": "replace-platform-state-with-server-managed-audit" },
    "POST /api/regional-data-sharing/access-reviews": { "owner": "T02", "roles": ["commission", "institution"], "dataScope": "institution", "purpose": "execute-regional-sharing-access-review" },
    "GET /api/audit/verify": { "owner": "T01", "roles": ["commission"], "dataScope": "platform", "purpose": "verify-audit-integrity" },
    "GET /api/audit/export": { "owner": "T01", "roles": ["commission"], "dataScope": "platform", "purpose": "export-minimized-audit-evidence" },
    "GET /api/public-health/highlights": { "owner": "T03", "roles": ["commission"], "dataScope": "city and health-admin platform; district own organization or explicit public-health hospital allowlist", "purpose": "read-public-health-command-overview" },
    "POST /api/public-health/highlights/signals": { "owner": "T03", "roles": ["commission"], "dataScope": "institution", "purpose": "ingest-public-health-signal" },
    "POST /api/public-health/highlights/alerts/:id/actions": { "owner": "T03", "roles": ["commission"], "dataScope": "platform", "purpose": "dispatch-public-health-alert" },
    "POST /api/public-health/highlights/command-tasks/:id/actions": { "owner": "T03", "roles": ["commission"], "dataScope": "institution", "purpose": "operate-public-health-command-task" },
    "POST /api/public-health/highlights/ai-reviews/:id/actions": { "owner": "T03", "roles": ["commission"], "dataScope": "platform", "purpose": "human-review-public-health-ai-output" },
    "POST /api/public-health/highlights/evidence/:id/actions": { "owner": "T03", "roles": ["commission"], "dataScope": "platform", "purpose": "verify-public-health-evidence" },
    "GET /api/public-health/supervision/workbench": { "owner": "T03", "roles": ["commission", "institution"], "dataScope": "city and health-admin platform; district jurisdiction; medical institution own subject", "purpose": "read-health-supervision-workbench" },
    "POST /api/public-health/supervision/subjects": { "owner": "T03", "roles": ["commission"], "dataScope": "city and health-admin platform; district jurisdiction", "purpose": "register-health-supervision-subject-reference" },
    "POST /api/public-health/supervision/inspection-tasks": { "owner": "T03", "roles": ["commission"], "dataScope": "city and health-admin platform; district jurisdiction", "purpose": "create-health-supervision-inspection-task" },
    "POST /api/public-health/supervision/inspection-tasks/:id/actions": { "owner": "T03", "roles": ["commission"], "dataScope": "city and health-admin platform; district jurisdiction", "purpose": "operate-health-supervision-inspection-task" },
    "POST /api/public-health/supervision/findings/:id/actions": { "owner": "T03", "roles": ["commission", "institution"], "dataScope": "commission jurisdiction or medical institution own subject", "purpose": "submit-or-review-health-supervision-remediation" }
  }
}
