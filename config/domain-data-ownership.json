  "schemaVersion": "1.1.0",
  "storagePolicy": {
    "development": {
      "authoritative": "json-or-sqlite",
      "purpose": "local-demo-only"
    },
    "test": {
      "authoritative": "isolated-test-adapter",
      "purpose": "deterministic-automation"
    },
    "production": {
      "authoritative": "postgresql",
      "purpose": "system-of-record",
      "fallbackWrite": false
    }
  },
  "nonOwningDomains": [
    "shared",
    "state-data"
  ],
  "unregisteredCollectionPolicy": {
    "classification": "legacy-non-authoritative",
    "productionWriteAllowed": false,
    "promotionRequires": [
      "explicit-domain-owner",
      "data-classification",
      "reader-allowlist",
      "versioned-write-contract",
      "migration-and-rollback-evidence"
    ]
  },
