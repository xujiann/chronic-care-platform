{
  "schemaVersion": "1.0.0",
  "storagePolicy": {
    "development": {
      "authoritative": "json-or-sqlite",
      "purpose": "local-demo-only"
    },
    "test": {
      "authoritative": "isolated-test-adapter",
      "purpose": "deterministic-automation"
    },
    "production": {
      "authoritative": "postgresql",
      "purpose": "system-of-record",
      "fallbackWrite": false
