{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "types": ["node"]
  },
  "include": [
    "scripts/run-standard-test-suite.js",
    "scripts/production-cutover-action-register.js",
    "scripts/standard-build.js",
    "scripts/static-publication.js",
    "scripts/test-all.js",
    "src/http/static-asset-policy.js",
    "src/platform/data/public-demo-snapshot.js",
    "src/platform/governance/production-evidence-trust-provider.js"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "playwright-report",
    "test-results",
    "release",
    "output"
  ]
}
