# Non-secret imaging cloud production deployment contract.
# Set secret values only through Vault, KMS or the production orchestrator.
IMAGING_DEPLOYMENT_ENV=production
DEPLOYMENT_SECRET_PROVIDER=vault
DEPLOYMENT_RELEASE_ID=<approved-release-id>
DEPLOYMENT_ARTIFACT_DIGEST=sha256:<64-lowercase-hex-digest>

# Do not use loopback addresses in a production deployment.
IMAGING_FHIR_BASE_URL=https://fhir.example.health.cn/fhir
IMAGING_DICOMWEB_BASE_URL=https://dicom.example.health.cn/dicom-web
IMAGING_OHIF_BASE_URL=https://viewer.example.health.cn

# PACS network endpoint and public certificate fingerprint; no patient data belongs here.
IMAGING_PACS_DICOM_TLS_HOST=pacs-gateway.example.health.cn
IMAGING_PACS_DICOM_TLS_PORT=2762
IMAGING_PACS_DICOM_TLS_CERT_SHA256=sha256:<64-lowercase-hex-digest>

IMAGING_OBJECT_STORAGE_REGION=liaoning-in-province
IMAGING_OBJECT_STORAGE_ENCRYPTION=enabled
IMAGING_AUDIT_RETENTION_DAYS=180
IMAGING_MOBILE_ORIGINAL_DICOM_POLICY=no-original-dicom-on-mobile
IMAGING_CONFIGURATION_EVIDENCE_REF=<change-or-configuration-record-reference>
