# Pilot cutover monitoring lifecycle
# Use absolute paths owned by the runtime account. Do not place this journal in the repository.
PLATFORM_PILOT_CUTOVER_ALERT_JOURNAL_FILE=

# Comma-separated subset of SIEM,WEBHOOK. At least one route is required.
PLATFORM_PILOT_CUTOVER_ALERT_ROUTES=
PLATFORM_PILOT_CUTOVER_ALERT_MAX_ATTEMPTS=3
PLATFORM_PILOT_CUTOVER_EVIDENCE_WARNING_HOURS=24

# Receivers and credentials must be injected by the deployment secret manager.
# HTTPS is mandatory for production-like environments.
SIEM_ENDPOINT=
SIEM_SIGNING_SECRET=
SIEM_TOKEN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TOKEN=
ALERTING_TIMEOUT_MS=8000

# Repository configuration never proves monitoring acceptance.
CUTOVER_MONITORING_DELIVERY_ACCEPTED=false
CUTOVER_MONITORING_PAGING_ACCEPTED=false
CUTOVER_MONITORING_ESCALATION_ACCEPTED=false
CUTOVER_MONITORING_RECOVERY_ACCEPTED=false
