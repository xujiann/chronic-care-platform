# Disabled by default. Enable only after the official schema, network path,
# managed secrets, agency credentials and joint-test evidence are approved.
NODE_ENV=production
STORAGE_ENGINE=sqlite
PUBLIC_HEALTH_DIRECT_REPORT_WORKER_ENABLED=false
PUBLIC_HEALTH_DIRECT_REPORT_WORKER_ID=replace-with-stable-instance-id
PUBLIC_HEALTH_DIRECT_REPORT_RUNTIME_MODULE=public-health-direct-report-production-runtime.js
PUBLIC_HEALTH_DIRECT_REPORT_WORKER_BATCH_SIZE=20
PUBLIC_HEALTH_DIRECT_REPORT_WORKER_LEASE_SECONDS=120

PUBLIC_HEALTH_DIRECT_REPORT_URL=https://replace-with-official-endpoint.example/direct-report
PUBLIC_HEALTH_DIRECT_REPORT_SECRET=inject-from-secret-manager
PUBLIC_HEALTH_REFERENCE_SECRET=inject-independent-reference-secret
PUBLIC_HEALTH_DIRECT_REPORT_CALLBACK_SECRET=inject-independent-callback-secret
PUBLIC_HEALTH_DIRECT_REPORT_TOKEN=inject-agency-token-if-required
PUBLIC_HEALTH_DIRECT_REPORT_TIMEOUT_MS=8000
PUBLIC_HEALTH_DIRECT_REPORT_MAX_ATTEMPTS=3
