# Central production adapters remain disabled until schema, reconciliation,
# external evidence and independent approvals have been verified.
PLATFORM_PRODUCTION_ADAPTER_MODE=disabled
PLATFORM_PRODUCTION_WORKERS_ENABLED=false
PLATFORM_PRODUCTION_WORKER_ID=

# Shadow relay is a separate process and remains closed by default.
# Use an absolute path writable only by the service account.
PLATFORM_SHADOW_RELAY_ENABLED=false
PLATFORM_SHADOW_CHECKPOINT_FILE=
PLATFORM_SHADOW_OPERATIONS_FILE=
PLATFORM_SHADOW_RECONCILIATION_MAX_AGE_MINUTES=60

# Metadata-only operational snapshots and controlled evidence references.
# This must be an absolute path readable only by the API/operations account.
PLATFORM_OPERATIONAL_CONTROL_INPUT_FILE=

# Immutable pilot cutover package produced by platform-cutover-package.
# The API reads and evaluates this file but never executes cutover.
PLATFORM_PILOT_CUTOVER_INPUT_FILE=

# Append-only metadata ledger produced by platform-cutover-authorization.
# This must be an absolute regular-file path; the API opens it read-only.
PLATFORM_PILOT_CUTOVER_AUTHORIZATION_LEDGER_FILE=

# Metadata-only registry of active Ed25519 public keys for cutover evidence,
# approvals and rehearsal coordination. Private keys must never be stored here.
PLATFORM_PILOT_CUTOVER_TRUST_REGISTRY_FILE=

# When remote provider files are configured, they replace the static registry.
# Any provider error fails closed and must never fall back to the file above.
PLATFORM_PILOT_CUTOVER_TRUST_PROVIDER_SNAPSHOT_FILE=
PLATFORM_PILOT_CUTOVER_TRUST_PROVIDER_ANCHORS_FILE=
PLATFORM_PILOT_CUTOVER_TRUST_PROVIDER_MAX_AGE_MINUTES=60
PLATFORM_PILOT_CUTOVER_TRUST_KEY_EXPIRY_WARNING_HOURS=168

# Strict production preflight accepts only a bounded, regular-file signed envelope
# whose Ed25519 trust-anchor bundle matches the independently pinned SHA-256 digest.
# Both JSON files are external metadata mounts; no private key or evidence body belongs here.
PRODUCTION_EVIDENCE_TRUST_ANCHORS_FILE=
PRODUCTION_EVIDENCE_TRUST_ANCHORS_SHA256=
PRODUCTION_EVIDENCE_TRUST_ENVELOPE_FILE=
PRODUCTION_CUTOVER_ACTION_EVIDENCE_DIR=

# A passed pre-production rehearsal older than this remains NO-GO.
PLATFORM_PILOT_CUTOVER_REHEARSAL_MAX_AGE_HOURS=24

# Health endpoint emits an expiring-soon warning inside this window.
PLATFORM_PILOT_CUTOVER_EVIDENCE_WARNING_HOURS=24

# External joint-test and monitoring acceptance metadata. All paths are absolute,
# service-account controlled and contain no endpoint credentials or business payloads.
PLATFORM_EXTERNAL_JOINT_TEST_CAMPAIGN_FILE=
PLATFORM_EXTERNAL_JOINT_TEST_TRUST_REGISTRY_FILE=
PLATFORM_EXTERNAL_JOINT_TEST_EVIDENCE_FILE=
# Alert delivery remains disabled until the service account, journal and at
# least one approved HTTPS route are injected by the environment manager.
PLATFORM_PILOT_CUTOVER_ALERT_WORKER_ENABLED=false
PLATFORM_PILOT_CUTOVER_ALERT_WORKER_ACCOUNT=
PLATFORM_PILOT_CUTOVER_ALERT_JOURNAL_FILE=
PLATFORM_PILOT_CUTOVER_MONITORING_ACCEPTANCE_FILE=

# Continuous audit delivery remains production NO-GO after append-only-audit-source-v2
# until signed durable receipts and an external checkpoint anchor are implemented.
# Configure exactly one of SIEM_AUDIT_ENDPOINT or AUDIT_WORM_DIRECTORY.
SIEM_AUDIT_ENDPOINT=
SIEM_AUDIT_SIGNING_SECRET=
SIEM_AUDIT_TLS_MODE=system
SIEM_AUDIT_CA_FILE=
SIEM_AUDIT_CLIENT_CERT_FILE=
SIEM_AUDIT_CLIENT_KEY_FILE=
SIEM_AUDIT_TLS_SERVERNAME=
AUDIT_WORM_DIRECTORY=
AUDIT_DELIVERY_CHECKPOINT_PATH=
AUDIT_DELIVERY_SOURCE_CONTRACT=append-only-audit-source-v2
AUDIT_DELIVERY_BATCH_SIZE=200
AUDIT_DELIVERY_MAX_ATTEMPTS=3
AUDIT_DELIVERY_SERVICE_USER=
AUDIT_DELIVERY_SERVICE_GROUP=
AUDIT_DELIVERY_SERVICE_UID=
AUDIT_DELIVERY_SERVICE_GID=

# PostgreSQL connectivity is injected by the deployment secret manager.
DATABASE_URL=
POSTGRES_SSL_MODE=verify-full
POSTGRES_CA_FILE=
POSTGRES_SCHEMA=health_platform
POSTGRES_POOL_MAX=2

# PostgreSQL shadow processes remain disabled until the migration package and
# controlled transition metadata have been independently reviewed.
POSTGRES_SYNC_MODE=disabled
POSTGRES_SYNC_BACKLOG_SLO_MAX=20
POSTGRES_SYNC_PENDING_AGE_SLO_SECONDS=300
POSTGRES_RECONCILIATION_AGE_SLO_SECONDS=600
POSTGRES_RECONCILIATION_OPEN_CASES_SLO_MAX=0
POSTGRES_PRIMARY_READ_MODE=disabled
POSTGRES_PRIMARY_READ_MAX_COLLECTIONS=2000
POSTGRES_PRIMARY_READ_MAX_BYTES=134217728
POSTGRES_ADAPTER_MODE=disabled
POSTGRES_PRODUCTION_WRITE_MODE=disabled
POSTGRES_PRIMARY_STORAGE_MODE=disabled
POSTGRES_PRIMARY_POOL_MAX=4
POSTGRES_PRIMARY_CONNECT_TIMEOUT_MS=5000
POSTGRES_PRIMARY_IDLE_TIMEOUT_MS=30000
POSTGRES_PRIMARY_APPLICATION_NAME=health-platform-primary-storage
POSTGRES_PRIMARY_TRANSITION_INPUT_FILE=
POSTGRES_PRIMARY_TRANSITION_INPUT_SHA256=
POSTGRES_SCHEMA_EVIDENCE_ID=
POSTGRES_MIGRATION_EVIDENCE_ID=
POSTGRES_RECONCILIATION_EVIDENCE_ID=
POSTGRES_BACKUP_EVIDENCE_ID=
POSTGRES_RTO_RPO_EVIDENCE_ID=
POSTGRES_ROLLBACK_EVIDENCE_ID=
POSTGRES_CUTOVER_APPROVAL_ID=

IDENTITY_SECURITY_AUDIT_POSTGRES_MODE=disabled
IDENTITY_SECURITY_AUDIT_MIGRATION_EVIDENCE_ID=
IDENTITY_SECURITY_AUDIT_BACKUP_EVIDENCE_ID=
IDENTITY_SECURITY_AUDIT_RECOVERY_EVIDENCE_ID=
IDENTITY_SECURITY_AUDIT_CUTOVER_APPROVAL_ID=

REFERRAL_DELIVERY_POSTGRES_MODE=disabled
REFERRAL_DELIVERY_MIGRATION_EVIDENCE_ID=
REFERRAL_DELIVERY_BACKUP_EVIDENCE_ID=
REFERRAL_DELIVERY_RECOVERY_EVIDENCE_ID=
REFERRAL_DELIVERY_CUTOVER_APPROVAL_ID=
REFERRAL_DELIVERY_POSTGRES_TLS_PROBE_EVIDENCE_ID=

EMERGENCY_SIGNAL_POSTGRES_MODE=disabled
EMERGENCY_SIGNAL_MIGRATION_EVIDENCE_ID=
EMERGENCY_SIGNAL_BACKUP_EVIDENCE_ID=
EMERGENCY_SIGNAL_RECOVERY_EVIDENCE_ID=
EMERGENCY_SIGNAL_CUTOVER_APPROVAL_ID=

# Provider endpoints and credential references are injected at the target site.
REGIONAL_HIS_ENDPOINT=
REGIONAL_HIS_CREDENTIAL_REF=
REGIONAL_EMR_ENDPOINT=
REGIONAL_EMR_CREDENTIAL_REF=
REGIONAL_LIS_ENDPOINT=
REGIONAL_LIS_CREDENTIAL_REF=
REGIONAL_PACS_ENDPOINT=
REGIONAL_PACS_CREDENTIAL_REF=
