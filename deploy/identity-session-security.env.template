# T01 身份与会话安全模板。此文件只声明契约，不包含真实密钥或生产证据。
NODE_ENV=production

# 生产默认只使用浏览器 Cookie。临时 Bearer 兼容必须显式配置，并会保持 NO-GO。
AUTH_SESSION_TRANSPORT=cookie
AUTH_BEARER_COMPATIBILITY=disabled
AUTH_COOKIE_SAME_SITE=Strict
AUTH_COOKIE_SECURE=true
AUTH_STEP_UP_MAX_AGE_SECONDS=600

# 从受管密钥服务注入，禁止提交真实值。
SESSION_SECRETS=replace-with-managed-rotating-secrets
CSRF_SECRET=replace-with-managed-csrf-secret

# OIDC：issuer 是外部主体唯一键的一部分。
OIDC_ISSUER_URL=https://identity.example.gov.cn/issuer
OIDC_CLIENT_ID=replace-with-managed-client-id
OIDC_CLIENT_SECRET=replace-with-managed-client-secret
OIDC_TOKEN_URL=https://identity.example.gov.cn/token
OIDC_REVOCATION_URL=https://identity.example.gov.cn/revoke
OIDC_USERINFO_URL=https://identity.example.gov.cn/userinfo
IDENTITY_DIRECTORY_URL=https://directory.example.gov.cn/scim/v2/Users
IDENTITY_DIRECTORY_TOKEN=replace-with-managed-directory-token
IDENTITY_DIRECTORY_ISSUER=https://identity.example.gov.cn/issuer

# SAML 只建立严格配置契约。当前没有断言运行时验证器，生产状态必须保持 NO-GO。
SAML_ENTRY_POINT=https://identity.example.gov.cn/saml/sso
SAML_ENTITY_ID=health-platform
SAML_AUDIENCE=health-platform
SAML_IDP_CERT_FINGERPRINT=replace-with-sha256-fingerprint
SAML_REQUIRE_SIGNED_ASSERTIONS=true
SAML_REQUIRE_SIGNED_RESPONSE=true
SAML_NAME_ID_FORMAT=urn:oasis:names:tc:SAML:2.0:nameid-format:persistent
