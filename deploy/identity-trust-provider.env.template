# T01 public trust directory inputs. Files must be absolute, bounded, non-symlink JSON files.
PLATFORM_PILOT_CUTOVER_TRUST_PROVIDER_SNAPSHOT_FILE=/etc/health-platform/trust/provider-snapshot.json
PLATFORM_PILOT_CUTOVER_TRUST_PROVIDER_ANCHORS_FILE=/etc/health-platform/trust/provider-anchors.json

# Fail-closed freshness and expiry policy.
PLATFORM_PILOT_CUTOVER_TRUST_PROVIDER_MAX_AGE_MINUTES=60
PLATFORM_PILOT_CUTOVER_TRUST_KEY_EXPIRY_WARNING_HOURS=168

# Do not add private keys, credentials or bearer tokens. Signing remains inside KMS/Vault.
