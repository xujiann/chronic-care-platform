# Replace REGION_CODE with the six-digit site code. Keep this file outside the application artifact.
REGIONAL_SITE_REGION_CODE_EVIDENCE_FILE=/absolute/controlled/path/regional-site-evidence.json
REGIONAL_SITE_REGION_CODE_EVIDENCE_SHA256=sha256:replace-with-exact-file-sha256

# One server-controlled registry can authorize distinct principals and scopes for multiple regions.
REGIONAL_SITE_EVIDENCE_TRUST_REGISTRY_FILE=/absolute/controlled/path/regional-site-evidence-trust-registry.json
REGIONAL_SITE_EVIDENCE_TRUST_REGISTRY_SHA256=sha256:replace-with-exact-registry-file-sha256

# Append-only lifecycle registry. Refresh the pin after every authorized lifecycle write.
REGIONAL_SITE_EVIDENCE_LIFECYCLE_REGISTRY_FILE=/absolute/controlled/path/regional-site-evidence-lifecycle-registry.json
REGIONAL_SITE_EVIDENCE_LIFECYCLE_REGISTRY_SHA256=sha256:replace-with-exact-lifecycle-registry-file-sha256
